NODE_ENV=development
HOST=127.0.0.1
PORT=5000
DATABASE_URL=postgresql://edutrack:replace-me@localhost:5432/edutrack_dev

# Use credentials from a development SMTP sandbox.
SMTP_HOST=sandbox.smtp.example
SMTP_PORT=587
SMTP_USER=replace-with-sandbox-user
SMTP_PASSWORD=replace-with-sandbox-password
EMAIL_FROM="EduTrack <no-reply@example.test>"

FRONTEND_URL=http://localhost:5173

SESSION_TTL_SECONDS=604800

# Optional Cloudinary credentials for course thumbnail uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
