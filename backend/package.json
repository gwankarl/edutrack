{
  "name": "@edutrack/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "start": "tsx src/app/server.ts",
    "test:unit": "vitest run --environment=node --exclude=**/*.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --project tsconfig.json",
    "db:seed:catalog": "tsx src/infrastructure/database/seeds/academic-catalog.seed.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:status": "tsx src/infrastructure/database/migration-status.ts"
  },
  "dependencies": {
    "@edutrack/contracts": "1.0.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^10.3.0",
    "argon2": "^0.45.2",
    "cloudinary": "^2.11.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "file-type": "^22.3.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
